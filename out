void Channel::broadcast(const std::string& message, int excludeFd) 
{
	for (std::map<int, Client*>::iterator it = clients.begin(); it != clients.end(); it++)
	{
		if (it->first != excludeFd)
		{
			it->second->getOutputBuffer() += message;
		}
	}
}

